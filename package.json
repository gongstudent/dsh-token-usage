{
  "name": "dsh-token-usage",
  "version": "0.1.0",
  "description": "DSH token 用量查看器：在当前会话的输入框区域显示本会话 token 用量（四桶 + 缓存命中率 + 上下文占用），点击展开明细。只读、无持久化、无宿主业务逻辑。Read-only per-session token usage readout for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node test/verify.mjs && node test/host.mjs",
    "sync-tokens": "node scripts/sync-tokens.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "context",
    "client-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5"
    }
  }
}
